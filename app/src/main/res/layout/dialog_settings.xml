<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/Label" android:text="@string/host" />

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView style="@style/Label" android:text="@string/resolution" />

        <Spinner
            android:id="@+id/resolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/master"
            style="@style/Toggle"
            android:text="@string/master" />

        <Switch
            android:id="@+id/glue"
            style="@style/Toggle"
            android:text="@string/glue" />

        <TextView style="@style/Label" android:text="@string/target" />

        <Spinner
            android:id="@+id/target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/keepwav"
            style="@style/Toggle"
            android:text="@string/keep_wav" />
    </LinearLayout>
</ScrollView>
